@startuml
!pragma layout smetana
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam dpi 180
scale 0.85
skinparam defaultFontSize 14
skinparam nodesep 20
skinparam ranksep 30
skinparam padding 3
hide empty methods
left to right direction
skinparam packageStyle folder
skinparam packageBackgroundColor white
skinparam packageBorderColor black
skinparam packageFontStyle bold
skinparam classBackgroundColor #F1F1F1
skinparam classBorderColor #888888
skinparam classFontColor black
skinparam ArrowColor black
package "Transit Network" {
abstract class Route {
 -routeNumber: Integer
 -origin: String
 -destination: String
}
class BusRoute
class OTrainLine
class Stop {
 -stopCode: String {unique}
 -name: String
 -location: String
}
class RouteStop {
 -position: Integer
 -minutesFromStart: Integer
}
abstract class Vehicle {
 -fleetNumber: Integer {unique}
 -passengerCapacity: Integer
}
class Bus {
 -bodyType: BusBodyType
}
class Train {
 -numberOfCars: Integer
}
enum BusBodyType {
 standard
 articulated
 doubleDecker
}
class Trip {
 -tripId: String {unique}
 -scheduledStart: DateTime
 -scheduledEnd: DateTime
}
}
package "Staff" {
class Driver
}
Route <|-- BusRoute
Route <|-- OTrainLine
Route "0..*" -- "2..*" Stop : serves
(Route, Stop) .. RouteStop
Vehicle <|-- Bus
Vehicle <|-- Train
Route "1" -- "0..*" Trip : follows
Vehicle "1" -- "0..*" Trip : operates
Driver "1" -- "0..*" Trip : drives
@enduml
